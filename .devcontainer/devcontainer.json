{
  "name": "uav-cyber-sim",
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile",
    "args": {
      "UID": "${localEnv:UID:-1000}",
      "GID": "${localEnv:GID:-1000}",
      "NETSIM_IMAGE": "${localEnv:NETSIM_IMAGE:-ubuntu:22.04}"
    }
  },
  // host networking gives full port access on Linux; on macOS/Windows Docker Desktop
  // it is silently ignored — use forwardPorts below or run on Linux for large fleets
  "runArgs": [
    "--network",
    "host"
  ],
  "initializeCommand": "mkdir -p .claude",
  // Xvfb display :99 is started in postStartCommand — works on every platform
  // without requiring an X server on the host
  "containerEnv": {
    "DISPLAY": ":99"
  },
  "mounts": [
    "source=${localWorkspaceFolder}/.claude,target=/root/.claude,type=bind,consistency=cached"
  ],
  "postStartCommand": "Xvfb :99 -screen 0 1920x1080x24 &>/tmp/xvfb.log &",
  "postAttachCommand": "sudo chown -R ubuntu /workspaces",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "remoteUser": "ubuntu"
}
